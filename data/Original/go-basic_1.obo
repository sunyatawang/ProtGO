synonym: "DDT resistance" RELATED []
synonym: "DDT susceptibility/resistance" RELATED []
is_a: GO:0014070 ! response to organic cyclic compound
is_a: GO:0017085 ! response to insecticide

[Term]
id: GO:0046681
