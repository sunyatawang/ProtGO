id: GO:0005789
name: endoplasmic reticulum membrane
namespace: cellular_component
def: "The lipid bilayer surrounding the endoplasmic reticulum." [GOC:mah]
synonym: "ER membrane" EXACT []
is_a: GO:0031090 ! organelle membrane
