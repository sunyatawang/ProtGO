subset: goslim_chembl
subset: goslim_metagenomics
subset: goslim_pir
subset: goslim_plant
subset: goslim_pombe
subset: goslim_yeast
synonym: "biological process" EXACT []
synonym: "physiological process" EXACT []
synonym: "single organism process" RELATED []
synonym: "single-organism process" RELATED []
