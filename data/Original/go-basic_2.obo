[Term]
id: GO:0098031
name: icosahedral viral capsid, collar
namespace: cellular_component
def: "A small disk located at the base of some icosahedral virus capsids." [GOC:bm]
is_a: GO:0044423 ! virion component
relationship: part_of GO:0019030 ! icosahedral viral capsid

[Term]
id: GO:0098032
