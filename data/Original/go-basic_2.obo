[Term]
id: GO:1904226
name: regulation of glycogen synthase activity, transferring glucose-1-phosphate
namespace: biological_process
def: "Any process that modulates the frequency, rate or extent of glycogen synthase activity, transferring glucose-1-phosphate." [GO_REF:0000059, GOC:BHF, GOC:rl, GOC:TermGenie, PMID:17569761]
is_a: GO:0051338 ! regulation of transferase activity

[Term]
id: GO:1904227
name: negative regulation of glycogen synthase activity, transferring glucose-1-phosphate
namespace: biological_process
def: "Any process that stops, prevents or reduces the frequency, rate or extent of glycogen synthase activity, transferring glucose-1-phosphate." [GO_REF:0000059, GOC:BHF, GOC:rl, GOC:TermGenie, PMID:17569761]
synonym: "down regulation of glycogen synthase activity, transferring glucose-1-phosphate" EXACT [GOC:TermGenie]
